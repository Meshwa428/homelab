# Env symlinks — all point to shared/.env, never commit
**/.env
shared/.env

# Keep the example template
!shared/.env.example

# Tailscale state (contains private keys)
**/state/
**/ts-dns-state/
**/ts-traefik-state/
**/tailscale-state/

# TLS certs
**/letsencrypt/
**/certs/

# App data & databases
**/data/
**/config/
**/runtime/
**/models/
**/db/
**/library/
**/redis-data/
**/resources/

# RomM MariaDB runtime data (root-owned, not portable)
services/romm/db/
services/romm/redis-data/
services/romm/library/
services/romm/resources/

# Logs
*.log
*.log1.txt
*.log2.txt

# Portainer DB
portainer.db
*.db
apps/honeygain/.env

# Wrapper
apple-music-downloader/
**/rootfs/
*.so
*.zip

# Kiwix
**/*.tmp
**/*.zim

# ACME certificate storage (contains Let's Encrypt keys)
**/acme/
