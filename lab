  ./lab model list
  ./lab model remove mistral
  ./lab kiwix list                       # See available Kiwix categories
  ./lab kiwix pull devdocs               # Download DevDocs offline
  ./lab kiwix status                     # View downloaded ZIM files

EOF
}

# =============================================================================
# Completions command
# =============================================================================
cmd_completions() {
  cat <<'COMP'
#compdef lab

_lab() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            local -a commands
            commands=(
                'up:Start all services, or a specific one'
                'down:Stop all services, or a specific one'
                'restart:Recreate a service container'
                'logs:Follow logs'
                'pull:Pull latest image(s)'
                'remove:Stop and remove containers (keeps files)'
                'delete:Remove containers AND delete service dir'
                'status:Health table for all services'
                'heal:Start any crashed or missing services'
                'list:List all services'
                'network:Ensure the shared proxy network exists'
                'model:Manage llama-swap models'
                'kiwix:Manage Kiwix offline content library'
                'completions:Print Zsh autocompletion script'
                'help:View full command reference'
            )
            _describe -t commands 'subcommand' commands ;;
        args)
            case $words[1] in
                up|down|restart|logs|pull|remove|delete)
                    local -a services
                    services=($(python3 -c "
import os
services = []
for root, dirs, files in os.walk('$HOME/homelab'):
    if 'compose.yml' in files or 'docker-compose.yml' in files:
        if any(p in root for p in ['/core/', '/services/', '/apps/', '/shared/']):
            services.append(os.path.basename(root))
print(' '.join(sorted(services)))
" 2>/dev/null))
                    _describe -t services 'service' services ;;
                heal)
                    case $CURRENT in
                        2)
                            local -a heal_subcmds
                            heal_subcmds=(
                                'blacklist:List or manage services excluded from healing'
                            )
                            _describe -t heal_subcmds 'heal subcommand' heal_subcmds ;;
                        3)
                            if [[ "$words[2]" == "blacklist" ]]; then
                                local -a blacklist_subcmds
                                blacklist_subcmds=(
                                    'add:Add a service to the heal blacklist'
                                    'remove:Remove a service from the heal blacklist'
                                )
                                _describe -t blacklist_subcmds 'blacklist subcommand' blacklist_subcmds
                            fi ;;
                        4)
                            if [[ "$words[2]" == "blacklist" ]] && [[ "$words[3]" == "add" || "$words[3]" == "remove" ]]; then
                                local -a services
                                services=($(python3 -c "
import os
services = []
for root, dirs, files in os.walk('$HOME/homelab'):
    if 'compose.yml' in files or 'docker-compose.yml' in files:
        if any(p in root for p in ['/core/', '/services/', '/apps/', '/shared/']):
            services.append(os.path.basename(root))
print(' '.join(sorted(services)))
" 2>/dev/null))
                                _describe -t services 'service' services
                            fi ;;
                    esac ;;
                model)
                    case $CURRENT in
                        2)
                            local -a model_subcmds
                            model_subcmds=(
                                'pull:Download & register a model from HuggingFace'
                                'remote:List all available quants in a remote HuggingFace repo'
                                'list:List registered models and their keys'
                                'files:List downloaded GGUF files with sizes'
                                'remove:Remove model from config (optionally disk)'
                            )
                            _describe -t model_subcmds 'model subcommand' model_subcmds ;;
                        3)
                            if [[ "$words[2]" == "remove" ]]; then
                                local -a model_keys
                                model_keys=($(python3 -c "
import yaml
try:
    with open('$HOME/homelab/services/llama-swap/config.yaml') as f:
        config = yaml.safe_load(f)
    print(' '.join(config.keys()))
except Exception:
    pass
" 2>/dev/null))
                                if (( ${#model_keys} > 0 )); then
                                    _describe -t model_keys 'model key' model_keys
                                fi
                            fi ;;
                    esac ;;
                kiwix)
                    # Helper: ensure category cache exists
                    _lab_kiwix_categories() {
                        local cache_dir="$HOME/.cache/lab"
                        local cache_file="$cache_dir/kiwix_categories"
                        local max_age=86400
                        if [[ ! -f "$cache_file" ]] || (( $(date +%s) - $(date -r "$cache_file" +%s 2>/dev/null || echo 0) > max_age )); then
                            mkdir -p "$cache_dir"
                            wget -qO- "https://download.kiwix.org/zim/" 2>/dev/null \
                                | grep -oP '(?<=href=")[a-zA-Z0-9_-]+(?=/)' \
                                | sort -u > "$cache_file" 2>/dev/null
                        fi
                        if [[ -f "$cache_file" ]]; then
                            local -a categories
                            categories=(${(f)"$(< $cache_file)"})
                            _describe -t categories 'kiwix category' categories
                        fi
                    }

                    case $CURRENT in
                        2)
                            local -a kiwix_subcmds
                            kiwix_subcmds=(
                                'list:List all available categories on Kiwix'
                                'browse:List files in a category'
                                'pull:Download latest ZIM(s) for a category'
                                'file:Download one exact file by name'
                                'status:Show downloaded ZIM files and sizes'
                            )
                            _describe -t kiwix_subcmds 'kiwix subcommand' kiwix_subcmds ;;
                        3)
                            # browse/pull/file all take a category as first arg
                            if [[ "$words[2]" == "browse" || "$words[2]" == "pull" || "$words[2]" == "file" ]]; then
                                _lab_kiwix_categories
                            fi ;;
                        4)
                            if [[ "$words[2]" == "file" ]]; then
                                # Fetch and cache file list for this category
                                local category="$words[3]"
                                local cache_dir="$HOME/.cache/lab"
                                local cache_file="$cache_dir/kiwix_files_${category}"
                                local max_age=86400
                                if [[ ! -f "$cache_file" ]] || (( $(date +%s) - $(date -r "$cache_file" +%s 2>/dev/null || echo 0) > max_age )); then
                                    mkdir -p "$cache_dir"
                                    wget -qO- "https://download.kiwix.org/zim/${category}/" 2>/dev/null \
                                        | grep -oP 'href="[^"]+\.zim"' \
                                        | grep -oP '"[^"]+"' \
                                        | tr -d '"' \
                                        | sort > "$cache_file" 2>/dev/null
                                fi
                                if [[ -f "$cache_file" ]]; then
                                    local -a files
                                    files=(${(f)"$(< $cache_file)"})
                                    _describe -t files 'zim file' files
                                fi
                            elif [[ "$words[2]" == "pull" ]]; then
                                # pull accepts multiple categories
                                _lab_kiwix_categories
                            fi ;;
                        *)
                            # pull accepts multiple categories
                            if [[ "$words[2]" == "pull" ]]; then
                                _lab_kiwix_categories
                            fi ;;
                    esac ;;
            esac ;;
    esac
}

_lab "$@"
COMP
}

# =============================================================================
# Entry point
# =============================================================================
COMMAND="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$COMMAND" in
  up)      cmd_up "$@" ;;
  down)    cmd_down "$@" ;;
  restart) cmd_restart "$@" ;;
  logs)    cmd_logs "$@" ;;
  pull)    cmd_pull "$@" ;;
  remove)  cmd_remove "$@" ;;
  delete)  cmd_delete "$@" ;;
  status)  cmd_status ;;
  heal)    cmd_heal "$@" ;;
  list)    cmd_list ;;
  network) cmd_network ;;
  model)   cmd_model "$@" ;;
  kiwix)   cmd_kiwix "$@" ;;
  completions) cmd_completions ;;
  help|--help|-h) usage ;;
  *)       error "Unknown command: '$COMMAND'. Run './lab help'" ;;
esac
