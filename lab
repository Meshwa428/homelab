# Entry point
# =============================================================================
COMMAND="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$COMMAND" in
  up)      cmd_up "$@" ;;
  down)    cmd_down "$@" ;;
  restart) cmd_restart "$@" ;;
  logs)    cmd_logs "$@" ;;
  pull)    cmd_pull "$@" ;;
  remove)  cmd_remove "$@" ;;
  delete)  cmd_delete "$@" ;;
  status)  cmd_status "$@" ;;
  heal)    cmd_heal "$@" ;;
  list)    cmd_list "$@" ;;
  network) cmd_network "$@" ;;
  model)   cmd_model "$@" ;;
  kiwix)   cmd_kiwix "$@" ;;
  completions) cmd_completions "$@" ;;
  help|--help|-h) usage ;;
  *)       error "Unknown command: '$COMMAND'. Run './lab help'" ;;
esac
