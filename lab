#!/bin/bash
# =============================================================================
# lab — Homelab CLI
# =============================================================================
# A single unified interface for managing all homelab services and models.
# Place this file at the root of your homelab repo and run it as ./lab
#
# USAGE:
#   ./lab <command> [args...]
#
# Run './lab help' for full command reference.
# =============================================================================

set -euo pipefail

HOMELAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$HOMELAB_DIR/scripts"

# --- Colors ------------------------------------------------------------------
GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; RED=$'\033[0;31m'
CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'

info()   { echo -e "  ${GREEN}✓${NC}  $*"; }
warn()   { echo -e "  ${YELLOW}!${NC}  $*"; }
error()  { echo -e "  ${RED}✗${NC}  $*" >&2; exit 1; }
step()   { echo -e "  ${CYAN}→${NC}  $*"; }
header() { echo -e "\n${BOLD}${CYAN}$*${NC}\n"; }

# =============================================================================
# Per-command help functions
# =============================================================================

help_up() {
  cat <<'EOF'

EOF
  cat <<EOF
${BOLD}./lab up${NC} ${DIM}[service...]${NC}

${BOLD}DESCRIPTION${NC}
  Start one or more services, or all services if none are specified.
  Boot order is resolved automatically via the dependency graph.

${BOLD}ARGUMENTS${NC}
  ${CYAN}[service...]${NC}   Zero or more service names. Omit to start all services.

${BOLD}BEHAVIOR${NC}
  For each service, the current health state is checked first:
    ${GREEN}running${NC}   Prompts to recreate (--force-recreate)
    ${YELLOW}exited${NC}    Prompts to start existing containers
    ${YELLOW}partial${NC}   Prompts to recreate all, or just start missing
    ${DIM}missing${NC}   Pulls images, then creates and starts
  Dependencies are always started before the services that need them.

${BOLD}EDGE CASES${NC}
  Unknown service names error before anything starts.
  Stopping vpn will drop Tailscale/SSH if you are connected remotely.

${BOLD}EXAMPLES${NC}
  ./lab up                    # Start all services
  ./lab up traefik            # Start traefik (vpn dep resolved first)
  ./lab up open-webui         # Starts llama-swap dep first
  ./lab up dns traefik        # Multiple services, dep-ordered

EOF
}

help_down() {
  cat <<EOF

${BOLD}./lab down${NC} ${DIM}[service...]${NC}

${BOLD}DESCRIPTION${NC}
  Stop one or more services, or all services if none are specified.
  Stops in reverse dependency order.

${BOLD}ARGUMENTS${NC}
  ${CYAN}[service...]${NC}   Zero or more service names. Omit to stop all services.

${BOLD}BEHAVIOR${NC}
  No args: stops ALL services in reverse boot order.
  With args: stops only named services in reverse dep order.
  Always asks you to type ${BOLD}yes${NC} (not just y) before proceeding.
  Extra warning shown if vpn is in the stop list.

${BOLD}EDGE CASES${NC}
  Confirmation requires exactly "yes" not "y" or "Y".
  Stopping vpn drops Tailscale/SSH access if you are remote.

${BOLD}EXAMPLES${NC}
  ./lab down                  # Stop everything
  ./lab down open-webui       # Stop one service
  ./lab down dns traefik      # Stop multiple

EOF
}

help_restart() {
  cat <<EOF

${BOLD}./lab restart${NC} ${CYAN}<service...>${NC}

${BOLD}DESCRIPTION${NC}
  Force-recreate one or more service containers without pulling new images.
  Use this to pick up config changes (e.g., after editing config.yaml or .env).

${BOLD}ARGUMENTS${NC}
  ${CYAN}<service...>${NC}   One or more service names (required).

${BOLD}BEHAVIOR${NC}
  Runs: docker compose up -d --force-recreate
  Does NOT pull new images — use ./lab pull for that.
  Does NOT follow dependency order — only named services are restarted.

${BOLD}EXAMPLES${NC}
  ./lab restart llama-swap
  ./lab restart open-webui traefik

EOF
}

