  ${CYAN}pull <repo[:quant]> [key] [options]${NC}   Download model from HuggingFace and register it
  ${CYAN}remote <repo_id>${NC}                      List all available quants in a remote HuggingFace repo
  ${CYAN}list${NC}                                  List all registered models in config
  ${CYAN}files${NC}                                 List downloaded GGUF files with sizes
  ${CYAN}remove <key>${NC}                          Remove a model from config (optionally delete file)

${BOLD}TIPS${NC}
  Run ${BOLD}./lab model <subcommand> --help${NC} for detailed help on any subcommand.

${BOLD}EXAMPLES${NC}
  ./lab model remote openbmb/MiniCPM-V-4.6-Thinking-gguf
  ./lab model pull openbmb/MiniCPM-V-4.6-Thinking-gguf:Q4_K_M
  ./lab model pull BAAI/bge-large-en-v1.5-gguf:Q4_K_M --pooling cls
