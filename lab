#!/bin/bash
# =============================================================================
# lab — Homelab CLI
# =============================================================================
# A single unified interface for managing all homelab services and models.
# Place this file at the root of your homelab repo and run it as ./lab
#
# USAGE:
#   ./lab <command> [args...]
#
# Run './lab help' for full command reference.
# =============================================================================

set -euo pipefail

HOMELAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$HOMELAB_DIR/scripts"

# --- Colors ------------------------------------------------------------------
GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; RED=$'\033[0;31m'
CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'

info()   { echo -e "  ${GREEN}✓${NC}  $*"; }
warn()   { echo -e "  ${YELLOW}!${NC}  $*"; }
error()  { echo -e "  ${RED}✗${NC}  $*" >&2; exit 1; }
step()   { echo -e "  ${CYAN}→${NC}  $*"; }
header() { echo -e "\n${BOLD}${CYAN}$*${NC}\n"; }

# =============================================================================
# Service commands — delegate to manage.sh
# =============================================================================

cmd_up()      { "$SCRIPTS_DIR/manage.sh" up "$@"; }
cmd_down()    { "$SCRIPTS_DIR/manage.sh" down "$@"; }
cmd_restart() { "$SCRIPTS_DIR/manage.sh" restart "$@"; }
cmd_logs()    { "$SCRIPTS_DIR/manage.sh" logs "$@"; }
cmd_pull()    { "$SCRIPTS_DIR/manage.sh" pull "$@"; }
cmd_remove()  { "$SCRIPTS_DIR/manage.sh" remove "$@"; }
cmd_delete()  { "$SCRIPTS_DIR/manage.sh" delete "$@"; }
cmd_status()  { "$SCRIPTS_DIR/manage.sh" status; }
cmd_heal()    { "$SCRIPTS_DIR/manage.sh" heal "$@"; }
cmd_list()    { "$SCRIPTS_DIR/manage.sh" list; }

# =============================================================================
# model subcommands
# =============================================================================

CONFIG_FILE="$HOMELAB_DIR/services/llama-swap/config.yaml"
MODELS_DIR="$HOMELAB_DIR/services/llama-swap/models"

# model pull <repo[:quant]> [key]
model_pull() {
  [[ $# -lt 1 ]] && { model_usage; exit 1; }
  LAB_INVOKED=1 "$SCRIPTS_DIR/hf-pull.sh" "$@"
}

# model list
model_list() {
  header "Registered models"
  if [[ ! -f "$CONFIG_FILE" ]] || ( ! grep -q "^  [a-zA-Z]" "$CONFIG_FILE" && ! grep -q "^  \"[a-zA-Z]" "$CONFIG_FILE" ) 2>/dev/null; then
    warn "No models registered yet. Use: ./lab model pull <repo>"
    return
  fi

  printf "  ${BOLD}%-50s %-10s %s${NC}\n" "KEY / REPOSITORY" "TTL" "QUANTS AVAILABLE"
  printf "  ${DIM}%-50s %-10s %s${NC}\n" "──────────────────────────────────────────────────" "──────────" "────────────────────────────────"

  python3 - "$CONFIG_FILE" <<'PYEOF'
import sys, re
config_path = sys.argv[1]
try:
    with open(config_path) as f:
        lines = f.readlines()
except Exception:
    sys.exit(0)

grouped = {}
current_key = None
current_ttl = None

for line in lines:
    if line.strip().startswith('#'):
        continue
    m = re.match(r'^  "([^"]+)"\s*:\s*$', line) or re.match(r'^  ([^":\s]+[^:]*)\s*:\s*$', line)
    if m:
        if current_key:
            base, quant = current_key.rsplit(':', 1) if ':' in current_key else (current_key, 'default')
            if base not in grouped:
                grouped[base] = {'ttl': current_ttl, 'quants': []}
            if quant not in grouped[base]['quants']:
                grouped[base]['quants'].append(quant)
        current_key = m.group(1)
        current_ttl = '—'
    elif line.strip().startswith('ttl:'):
        ttl_m = re.search(r'ttl:\s*(\d+)', line)
        if ttl_m:
            current_ttl = ttl_m.group(1)

if current_key:
    base, quant = current_key.rsplit(':', 1) if ':' in current_key else (current_key, 'default')
    if base not in grouped:
        grouped[base] = {'ttl': current_ttl, 'quants': []}
    if quant not in grouped[base]['quants']:
        grouped[base]['quants'].append(quant)

for base, info in grouped.items():
    quants_str = ", ".join(info['quants'])
    ttl_str = f"{info['ttl']}s" if info['ttl'] != '—' else '—'
    # Format with Cyan for repository
    print(f"  \033[0;36m{base:<50}\033[0m {ttl_str:<10} {quants_str}")
PYEOF
  echo ""
}

# model files
model_files() {
  header "Downloaded model files"
  if [[ ! -d "$MODELS_DIR" ]] || [[ -z "$(find "$MODELS_DIR" -type f -name "*.gguf" 2>/dev/null)" ]]; then
    warn "No .gguf files found in services/llama-swap/models/"
    return
  fi
  printf "  ${BOLD}%-50s %s${NC}\n" "FILE" "SIZE"
  printf "  ${DIM}%-50s %s${NC}\n"  "────────────────────────────────────────────────" "──────"
  find "$MODELS_DIR" -type f -name "*.gguf" | while read -r f; do
    SIZE=$(du -sh "$f" | cut -f1)
    rel_f="${f#"$MODELS_DIR"/}"
    printf "  %-50s ${CYAN}%s${NC}\n" "$rel_f" "$SIZE"
  done
  echo ""
}

# model remove <key>
model_remove() {
  [[ $# -lt 1 ]] && { echo "Usage: ./lab model remove <key>"; exit 1; }
  local key="$1"
  [[ ! -f "$CONFIG_FILE" ]] && error "Config not found: $CONFIG_FILE"
  grep -q "^  ${key}:" "$CONFIG_FILE" || grep -q "^  \"${key}\":" "$CONFIG_FILE" || error "Model key '${key}' not found in config."

  # Get the model and mmproj file paths from config before deleting
  local model_file mmproj_file
  model_file=$(grep -A3 -E "^  (\"${key}\"|${key}):" "$CONFIG_FILE" | grep -oP '(?<=--model )[^ ]+' | head -1 || true)
  mmproj_file=$(grep -A3 -E "^  (\"${key}\"|${key}):" "$CONFIG_FILE" | grep -oP '(?<=--mmproj )[^ ]+' | head -1 || true)

  local local_file=""
  if [[ -n "$model_file" ]]; then
    local rel_path
    rel_path=$(echo "$model_file" | sed 's|^/models/||')
    local_file="$MODELS_DIR/$rel_path"
  fi

  local local_mmproj=""
  if [[ -n "$mmproj_file" ]]; then
    local mmproj_rel_path
    mmproj_rel_path=$(echo "$mmproj_file" | sed 's|^/models/||')
    local_mmproj="$MODELS_DIR/$mmproj_rel_path"
  fi

  echo ""
  echo -e "  ${YELLOW}${BOLD}⚠  This will remove '${key}' from config.yaml.${NC}"
  [[ -n "$local_file" ]] && echo -e "  ${DIM}Model file: $local_file${NC}"
  [[ -n "$local_mmproj" ]] && echo -e "  ${DIM}Projector file: $local_mmproj${NC}"
  echo -ne "\n  Also delete the model and projector files from disk? [y/N]: "
  read -r del_file

  # Remove from config
  python3 - "$CONFIG_FILE" "$key" <<'PYEOF'
import sys, re
config_path, key = sys.argv[1], sys.argv[2]
with open(config_path) as f:
    lines = f.readlines()
out, skip = [], False
for line in lines:
    if re.match(rf'^  "{re.escape(key)}":\s*$', line) or re.match(rf'^  {re.escape(key)}:\s*$', line):
        skip = True
    elif skip and re.match(r'^  \S', line):
        skip = False
    if not skip:
        out.append(line)
with open(config_path, 'w') as f:
    f.writelines(out)
PYEOF
  info "Removed '${key}' from config.yaml"

  if [[ "$del_file" =~ ^[Yy]$ ]]; then
    if [[ -n "$local_file" ]] && [[ -f "$local_file" ]]; then
      sudo rm -f "$local_file"
      info "Deleted file: $local_file"
    fi
    if [[ -n "$local_mmproj" ]] && [[ -f "$local_mmproj" ]]; then
      sudo rm -f "$local_mmproj"
      info "Deleted projector file: $local_mmproj"
    fi

    # Clean up parent directories if they are subdirectories of MODELS_DIR
    local parent_dir
    parent_dir=$(dirname "${local_file:-$local_mmproj}")
    if [[ -n "$parent_dir" ]] && [[ "$parent_dir" != "$MODELS_DIR" ]] && [[ "$parent_dir" == "$MODELS_DIR"/* ]]; then
      if [[ -d "$parent_dir" ]]; then
        sudo rm -rf "$parent_dir"
        info "Removed model directory: $parent_dir"
        
        # Safely clean up organization directory if it is empty
        local org_dir
        org_dir=$(dirname "$parent_dir")
        if [[ "$org_dir" != "$MODELS_DIR" ]] && [[ "$org_dir" == "$MODELS_DIR"/* ]]; then
          sudo rmdir "$org_dir" 2>/dev/null && info "Removed empty organization directory: $org_dir" || true
        fi
      fi
    fi
  fi

  echo ""
  warn "Restart llama-swap to apply: ./lab restart llama-swap"
}

# model remote <repo_id>
model_remote() {
  [[ $# -lt 1 ]] && { echo "Usage: ./lab model remote <repo_id>"; exit 1; }
  local repo_id="$1"
  
  python3 - "$repo_id" <<'PYEOF'
import sys, re, json
import urllib.request
import urllib.error

repo_id = sys.argv[1]
url = f"https://huggingface.co/api/models/{repo_id}"
req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})

try:
    with urllib.request.urlopen(req) as response:
        data = json.loads(response.read().decode('utf-8'))
except urllib.error.HTTPError as e:
    if e.code == 404:
        print(f"  \033[0;31m✗\033[0m  Repository '{repo_id}' not found on Hugging Face Hub.")
    elif e.code in (401, 403):
        print(f"  \033[0;31m✗\033[0m  Repository '{repo_id}' is private or does not exist (HTTP {e.code}).")
    else:
        print(f"  \033[0;31m✗\033[0m  Failed to fetch repository info (HTTP {e.code}).")
    sys.exit(1)
except Exception as e:
    print(f"  \033[0;31m✗\033[0m  Error connecting to Hugging Face Hub: {e}", file=sys.stderr)
    sys.exit(1)

siblings = data.get('siblings', [])
gguf_files = []
for s in siblings:
    filename = s.get('rfilename', '')
    if filename.lower().endswith('.gguf'):
        gguf_files.append(filename)

if not gguf_files:
    print(f"  \033[1;33m!\033[0m  No GGUF files found in repository '{repo_id}'.")
    sys.exit(0)

gguf_files.sort()

BOLD = "\033[1m"
CYAN = "\033[0;36m"
DIM = "\033[2m"
NC = "\033[0m"

# Print title
print(f"\n{BOLD}{CYAN}Available GGUF files in remote repository:{NC} {BOLD}{repo_id}{NC}\n")

max_len = max(len(f) for f in gguf_files)
file_width = min(max(max_len, 30), 65)

print(f"  {BOLD}{'GGUF FILE':<{file_width}} {'DETECTED TAG':<15} {'PULL COMMAND'}{NC}")
print(f"  {DIM}{'─'*file_width:<{file_width}} {'─'*15:<15} {'─'*50}{NC}")

quant_re = re.compile(r'(?i)(q[0-9]_[a-z0-9_]+|q[0-9]_[0-9]|f16|bf16|iq[0-9]_[a-z0-9_]+|q[0-9][a-z0-9_]+)')

for f in gguf_files:
    match = quant_re.search(f)
    if match:
        tag = match.group(1).upper()
    else:
        tag = "—"
    
    if tag != "—":
        pull_cmd = f"./lab model pull {repo_id}:{tag}"
    else:
        pull_cmd = f"./lab model pull {repo_id}"
        
    print(f"  {f:<{file_width}} {CYAN}{tag:<15}{NC} {pull_cmd}")

print("")
PYEOF
}

model_usage() {
  cat <<EOF

${BOLD}./lab model${NC} — Manage llama-swap models

${BOLD}SUBCOMMANDS${NC}
  ${CYAN}pull <repo[:quant]> [key] [options]${NC}   Download model from HuggingFace and register it
  ${CYAN}remote <repo_id>${NC}                    List all available quants in a remote HuggingFace repo
  ${CYAN}list${NC}                                List all registered models in config
  ${CYAN}files${NC}                               List downloaded GGUF files with sizes
  ${CYAN}remove <key>${NC}                        Remove a model from config (optionally delete file)

${BOLD}OPTIONS (for pull)${NC}
  ${CYAN}--mmproj-quant <quant>${NC}           Preferred quantization for vision projector file (default: f16)
  ${CYAN}--embedding${NC}                      Explicitly mark model as an embedding model
  ${CYAN}--pooling <strategy>${NC}             Custom pooling strategy for embedding models (e.g. mean, cls)

${BOLD}EXAMPLES${NC}
  ./lab model remote openbmb/MiniCPM-V-4.6-Thinking-gguf
  ./lab model pull openbmb/MiniCPM-V-4.6-Thinking-gguf:Q4_K_M
  ./lab model pull BAAI/bge-large-en-v1.5-gguf:Q4_K_M --pooling cls
  ./lab model list
  ./lab model files
  ./lab model remove mistral

EOF
}

cmd_model() {
  local sub="${1:-}"
  [[ -z "$sub" ]] && { model_usage; exit 0; }
  shift
  case "$sub" in
    -h|--help|help) model_usage ;;
    pull)   model_pull "$@" ;;
    remote) model_remote "$@" ;;
    list)   model_list ;;
    files)  model_files ;;
    remove) model_remove "$@" ;;
    *)      error "Unknown model subcommand: '$sub'. Run './lab model' for help." ;;
  esac
}

# =============================================================================
# kiwix subcommands
# =============================================================================

KIWIX_SCRIPT="$SCRIPTS_DIR/kiwix-pull.sh"
KIWIX_DATA="$HOMELAB_DIR/services/kiwix/data"

kiwix_list() {
  "$KIWIX_SCRIPT" --list
}

kiwix_browse() {
  [[ $# -lt 1 ]] && { echo "Usage: ./lab kiwix browse <category> [--lang <code>]"; exit 1; }
  local args=(--browse "$1")
  shift
  # Pass through any remaining flags (--lang, --all-lang)
  "$KIWIX_SCRIPT" "${args[@]}" "$@"
}

kiwix_pull() {
  [[ $# -lt 1 ]] && { echo "Usage: ./lab kiwix pull <category> [category2 ...] [--lang <code>] [--dry-run]"; exit 1; }
  "$KIWIX_SCRIPT" "$@"
}

kiwix_file() {
  [[ $# -lt 1 ]] && { echo "Usage: ./lab kiwix file <category> <filename>"; exit 1; }
  local arg1="$1"
  # If it's a URL, pass directly
  if [[ "$arg1" == http* ]]; then
    "$KIWIX_SCRIPT" --file "$arg1"
  else
    # arg1=category, arg2=filename → swap for kiwix-pull.sh (--file <name> <category>)
    [[ $# -lt 2 ]] && { echo "Usage: ./lab kiwix file <category> <filename>"; exit 1; }
    "$KIWIX_SCRIPT" --file "$2" "$1"
  fi
}

kiwix_status() {
  header "Kiwix library"
  if [[ ! -d "$KIWIX_DATA" ]] || [[ -z "$(find "$KIWIX_DATA" -type f -name '*.zim' 2>/dev/null)" ]]; then
    warn "No .zim files found. Use: ./lab kiwix pull <category>"
    echo ""
    step "Discover categories: ./lab kiwix list"
    return
  fi
  printf "  ${BOLD}%-55s %s${NC}\n" "FILE" "SIZE"
  printf "  ${DIM}%-55s %s${NC}\n" "───────────────────────────────────────────────────────" "──────"
  find "$KIWIX_DATA" -type f -name '*.zim' | sort | while read -r f; do
    local sz
    sz=$(du -sh "$f" | cut -f1)
    printf "  %-55s ${CYAN}%s${NC}\n" "$(basename "$f")" "$sz"
  done
  echo ""
}

kiwix_usage() {
  cat <<EOF

${BOLD}./lab kiwix${NC} — Manage Kiwix offline content library

${BOLD}SUBCOMMANDS${NC}
  ${CYAN}list${NC}                          List all available categories on Kiwix
  ${CYAN}browse <category>${NC}             List files in a category (use --lang to filter)
  ${CYAN}pull <category> [...]${NC}          Download latest ZIM(s) for a category
  ${CYAN}file <category> <filename>${NC}     Download one exact file by name
  ${CYAN}file <url>${NC}                     Download one exact file by URL
  ${CYAN}status${NC}                        Show downloaded ZIM files and sizes

${BOLD}OPTIONS${NC}  ${DIM}(pass after the subcommand)${NC}
  ${CYAN}--lang <code>${NC}                 Language filter (default: en)
  ${CYAN}--all-lang${NC}                    Download all languages
  ${CYAN}--dry-run${NC}                     Preview without downloading

${BOLD}EXAMPLES${NC}
  ./lab kiwix list
  ./lab kiwix browse wikipedia
  ./lab kiwix browse wikipedia --lang fr
  ./lab kiwix pull devdocs
  ./lab kiwix pull freecodecamp stack_exchange
  ./lab kiwix pull wikipedia --lang de
  ./lab kiwix pull devdocs --dry-run
  ./lab kiwix file wikipedia wikipedia_en_all_2026-02.zim
  ./lab kiwix file https://download.kiwix.org/zim/other/archlinux_en_all_maxi_2025-09.zim
  ./lab kiwix status

EOF
}

cmd_kiwix() {
  local sub="${1:-}"
  [[ -z "$sub" ]] && { kiwix_usage; exit 0; }
  shift
  case "$sub" in
    list)    kiwix_list ;;
    browse)  kiwix_browse "$@" ;;
    pull)    kiwix_pull "$@" ;;
    file)    kiwix_file "$@" ;;
    status)  kiwix_status ;;
    *)       error "Unknown kiwix subcommand: '$sub'. Run './lab kiwix' for help." ;;
  esac
}

# =============================================================================
# network command
# =============================================================================
cmd_network() {
  docker network inspect proxy >/dev/null 2>&1 \
    && echo "  proxy network already exists" \
    || (docker network create proxy && info "proxy network created")
}

# =============================================================================
# Usage
# =============================================================================
